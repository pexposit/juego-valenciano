# Context de build de Docker (arrel del monorepo).
# Evita que secrets, dependències locals i models entren a la imatge.

# Secrets: mai dins d'una imatge. Els .env.example sí que hi poden entrar.
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Dependències i artefactes: es generen dins del build.
**/node_modules
**/dist
**/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Entorn virtual i índex local del RAG (~3,8 GB): la imatge del RAG en genera l'índex pel seu compte.
rag_gnv/.venv
rag_gnv/index_gnv
rag_gnv/__pycache__

# Fonts dels recursos (HTML, PDF, models Blender...): només la GNV, de la qual el RAG genera l'índex.
assets-src/**
!assets-src/avl/
assets-src/avl/*
!assets-src/avl/gnv.txt

# Servici sense ús (no està en el compose).
classificador_llm/

# Eines de desenvolupament que cap imatge necessita: el laboratori de veu no es
# desplega i en local té entorns, models i àudios de desenes de GB.
speech-lab/

# Metadades del repo i de la CLI de Supabase.
.git
.github
supabase/.temp
supabase/.branches
**/*.log
.DS_Store
