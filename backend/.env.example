PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Mode demostració: permet jugar sense compte (usuari "demo-user", sense guardar
# res a la base de dades). A producció posa ALLOW_DEMO=false per a exigir sessió.
ALLOW_DEMO=true
# Límit de peticions per minut (finestra d'1 minut) per a /api/turn i /api/tts.
# Les peticions sense sessió (mode demostració) fan servir el límit anònim:
# protegix el crèdit d'OpenAI i el TTS de la UJI de l'ús anònim.
RATE_LIMIT_AUTHED_PER_MIN=30
RATE_LIMIT_ANON_PER_MIN=6
# Per a Supabase en local (Docker): executa `supabase start` dins del repositori i
# ompli estes dos amb el que mostra `supabase status`:
#   SUPABASE_URL           → Project URL (p. ex. http://127.0.0.1:54321)
#   SUPABASE_SERVICE_ROLE_KEY → Secret  (NOMÉS backend, mai al frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI configuration for the conversation agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# STT compatible OpenAI que executa el model matxa (whisper-1) al servidor DeepLab de la UJI.
# Exemple: curl -X POST http://deeplab.lsi.uji.es:11000/v1/audio/transcriptions -F model=whisper-1 -F language=ca -F file=audio.wav
MATXA_STT_URL=http://deeplab.lsi.uji.es:11000
MATXA_STT_MODEL=whisper-1
MATXA_STT_LANGUAGE=ca
# OpenAI-compatible TTS endpoint que executa el model matxa-tts.
# Ejemplo: curl -X POST http://deeplab.lsi.uji.es:11000/v1/audio/speech -d '{"model":"matxa-tts","input":"...","voice":"gina","response_format":"wav","language":"ca-es"}'
MATXA_TTS_URL=http://deeplab.lsi.uji.es:11000
