PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
CLASSIFICADOR_URL=http://localhost:8000
# RAG de la Gramàtica Normativa Valenciana (rag_gnv/): el tutor el consulta per als dubtes de normativa.
# Si no respon, el tutor contesta igual (sense la regla). RAG_GNV_ENABLED=false el desactiva.
RAG_GNV_URL=http://localhost:8010
# Reranker del RAG (Jev, de TypeSafe). Sense clau, el RAG usa el reranker local (GPU).
TYPESAFE_API_KEY=
# Mode demostració: permet jugar sense compte (usuari "demo-user", sense guardar
# res a la base de dades). A producció posa ALLOW_DEMO=false per a exigir sessió.
ALLOW_DEMO=true
# Límit de peticions per minut (finestra d'1 minut) per a /api/turn i /api/tts.
# Les peticions sense sessió (mode demostració) fan servir el límit anònim:
# protegix el crèdit d'OpenAI i el TTS de la UJI de l'ús anònim.
RATE_LIMIT_AUTHED_PER_MIN=30
RATE_LIMIT_ANON_PER_MIN=6
# Per a Supabase en local (Docker): executa `supabase start` dins del repositori i
# ompli estes dos amb el que mostra `supabase status`:
#   SUPABASE_URL           → Project URL (p. ex. http://127.0.0.1:54321)
#   SUPABASE_SERVICE_ROLE_KEY → Secret  (NOMÉS backend, mai al frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI configuration for the conversation agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# STT compatible OpenAI que executa el model matxa (whisper-1) al servidor DeepLab de la UJI.
# Exemple: curl -X POST https://krono.act.uji.es/deeplab/speechv1/audio/transcriptions -F model=whisper-1 -F language=ca -F file=audio.wav
MATXA_STT_URL=https://krono.act.uji.es/deeplab/speech
MATXA_STT_MODEL=whisper-1
MATXA_STT_LANGUAGE=ca
# OpenAI-compatible TTS endpoint que executa el model matxa-tts.
# Ejemplo: curl -X POST https://krono.act.uji.es/deeplab/speechv1/audio/speech -d '{"model":"matxa-tts","input":"...","voice":"gina","response_format":"wav","language":"ca-es"}'
MATXA_TTS_URL=https://krono.act.uji.es/deeplab/speech
# Laboratori de veu (speech-lab, necessita GPU): amb esta URL TOTES les veus (gina, lluc i les de personatge `rvc:doraemon`,
# `rvc:heidi`...) les genera el laboratori (Matxa + RVC) i no s'usa el DeepLab; si no respon, no hi ha àudio.
# Sense ella, tot va al DeepLab com sempre (i una veu `rvc:*` cau a gina). Opcional.
# També fa que el menú de veus del robot (tocant-lo) oferisca els personatges RVC; gina i lluc del menú (`remot:*`) van
# sempre al DeepLab.
# SPEECH_LAB_URL=http://localhost:3100

