{
  "name": "parlaval",
  "private": true,
  "workspaces": ["shared", "frontend", "backend", "speech-lab"],
  "scripts": {
    "dev": "npm run build -w shared && concurrently \"npm run dev -w frontend\" \"npm run dev -w backend\" \"npm run dev:rag\"",
    "build": "npm run build -w shared && npm run build -w frontend && npm run build -w backend",
    "test": "npm run build -w shared && npm run test -w backend",
    "setup:speech": "bash speech-lab/scripts/setup-vosk.sh",
    "setup:aina": "bash speech-lab/scripts/setup-aina.sh",
    "setup:toxicity": "powershell -NoProfile -ExecutionPolicy Bypass -File toxicity-classificator/setup.ps1",
    "models:speech": "cd speech-lab && .venv/bin/python scripts/models-hf.py descarrega",
    "dev:speech": "npm run dev -w speech-lab",
    "smoke:speech": "npm run smoke -w speech-lab",
    "wer:speech": "npm run wer -w speech-lab",
    "test:speech": "npm run test -w speech-lab",
    "dev:rag": "node rag_gnv/dev.mjs"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "openai": "^7.21.0",
    "pg": "^8.23.0"
  }
}
