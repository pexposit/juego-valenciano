# Entorn virtual de Python (Vosk) i models descarregats: pesen i no es trackegen.
.venv/
models/
*.zip
# Àudios de prova convertits a 16 kHz (es regeneren amb scripts/convert-samples.sh).
bench/samples/*.wav
# Els exemples de la pàgina SÍ es versionen (són els mateixos WAV, ~230 KB).
!public/samples/*.wav
__pycache__/
# Clonació de veu: entorn amb torch/demucs, àudios font i dataset generat (pesen i tenen drets).
.venv-voz/
audios/
voz-dataset/
# Matxa (es refà amb scripts/setup-matxa.sh). Només es versionen els models
# d'Aina (amb LFS), l'espeak compilat i els logs: el codi de Matcha i l'espeak
# font són clons, i les execucions (checkpoints, mostres, tensorboard) porten la
# veu del narrador de l'audiollibre.
tts/*
!tts/README.md
!tts/models/
tts/models/**/.cache/
!tts/espeak-ng/
!tts/narrador-v1.log
!tts/narrador-v1-b.log
!tts/espeak-build.log
