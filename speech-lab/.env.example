# Laboratori de veu en temps real. Cap d'estes variables és un secret.
# Port del servidor HTTP + WebSocket del laboratori.
SPEECH_LAB_PORT=3100
# Proveïdor de veu (ara només "vosk"; el registre n'accepta més sense tocar el servidor).
SPEECH_PROVIDER=vosk
# Freqüència d'amostratge que espera el reconeixedor (els models Vosk són de 16 kHz).
VOSK_SAMPLE_RATE=16000
# Intèrpret de Python de l'entorn virtual i model català (els crea `npm run setup:speech`).
VOSK_PYTHON=.venv/bin/python
VOSK_MODEL_PATH=models/vosk-model-small-ca-0.4
# Proveïdor de transcripció per lots (transcripció automàtica i bench WER).
BATCH_PROVIDER=aina
# Model català d'Aina (faster-whisper). La ruta local té prioritat; si no hi és,
# el sidecar el descarrega de Hugging Face amb AINA_MODEL_ID.
AINA_MODEL_ID=projecte-aina/faster-whisper-large-v3-ca-3catparla
AINA_MODEL_PATH=models/faster-whisper-large-v3-ca-3catparla
AINA_PYTHON=.venv/bin/python
# Proveïdor de síntesi (TTS). `matxa` és el mateix endpoint que ja usa el joc.
TTS_PROVIDER=matxa
MATXA_TTS_URL=http://deeplab.lsi.uji.es:11000
MATXA_TTS_MODEL=matxa-tts
MATXA_TTS_LANGUAGE=ca-es
MATXA_TTS_VOICE=gina
MATXA_TTS_VOICES=gina,lluc
# Port intern del sidecar de Vosk (només 127.0.0.1).
VOSK_SIDECAR_PORT=2700
