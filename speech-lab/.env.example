# Laboratori de veu en temps real. Cap d'estes variables és un secret.
# Port del servidor HTTP + WebSocket del laboratori.
SPEECH_LAB_PORT=3100
# Proveïdor de veu (ara només "vosk"; el registre n'accepta més sense tocar el servidor).
SPEECH_PROVIDER=vosk
# Freqüència d'amostratge que espera el reconeixedor (els models Vosk són de 16 kHz).
VOSK_SAMPLE_RATE=16000
# Intèrpret de Python de l'entorn virtual i model català (els crea `npm run setup:speech`).
VOSK_PYTHON=.venv/bin/python
VOSK_MODEL_PATH=models/vosk-model-small-ca-0.4
# Port intern del sidecar de Vosk (només 127.0.0.1).
VOSK_SIDECAR_PORT=2700
