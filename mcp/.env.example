# Variables del servidor MCP lingüístic (mcp/). Són pròpies d'este servici: no es mesclen amb les del backend.
# Copia este fitxer com a .env (en esta mateixa carpeta). En `docker compose` el carrega el servici `mcp`.
PORT=3002
# Token que el backend ha d'enviar (capçalera Authorization: Bearer ...). Ha de coincidir amb MCP_AUTH_TOKEN de
# backend/.env. Buit = sense autenticació (només en desenvolupament: en compose el servici no publica ports).
MCP_AUTH_TOKEN=
# Servicis externs que consulten les ferramentes (opcionals: estos són els valors per defecte).
# AVL_BASE_URL=https://www.avl.gva.es
# APERTIUM_URL=https://apertium.org/apy
# SOFTCATALA_URL=https://api.softcatala.org/corrector/v2/check
