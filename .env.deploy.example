# Variables per a docker-compose.yml (copia'l com a `.env` a l'arrel del repositori).
# Domini que apunta (registre DNS A/AAAA) a la IP del servidor.
# Per a provar-ho a la teua màquina: DOMAIN=localhost
DOMAIN=parlaval.example.com

# Correus de confirmació d'alta. true = sense correu (no cal SMTP).
ENABLE_EMAIL_AUTOCONFIRM=true
# SMTP_ADMIN_EMAIL=no-reply@parlaval.example.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SENDER_NAME=ParlaVal

# Secrets de Supabase: genera'ls (no els escrigues a mà) amb
#   node deploy/generate-secrets.mjs >> .env
# POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY
