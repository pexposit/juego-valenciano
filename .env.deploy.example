# Variables per a docker-compose.yml (copia'l com a `.env` a l'arrel del repositori).
# Domini que apunta (registre DNS A/AAAA) a la IP del servidor.
# Per a provar-ho a la teua màquina: DOMAIN=localhost
DOMAIN=parlaval.example.com

# Darrere d'un proxy invers (p. ex. https://servidor.example.com/parlaval):
#  - DOMAIN: el domini PÚBLIC del proxy (servidor.example.com).
#  - BASE_PATH: la subruta, sense barra final. El proxy pot reenviar-la tal qual
#    (nginx: `location /parlaval/ { proxy_pass http://IP-d-este-servidor/parlaval/; }`) o llevar-la: Caddy accepta les dos.
#  - SITE_ADDRESS=http:// perquè Caddy servisca HTTP pla (l'HTTPS el fa el proxy).
# Sense proxy, deixa-les comentades. Canviar BASE_PATH exigix reconstruir la web (--build).
# BASE_PATH=/parlaval
# SITE_ADDRESS=http://

# Claus compartides: UNA sola còpia, ací. El compose les passa a l'API i al RAG, i en `npm run dev` el backend i el RAG les
# llig d'este mateix fitxer (manen sobre backend/.env). Ja no cal repetir-les en backend/.env ni en rag_gnv/.env.
OPENAI_API_KEY=
# Reranker Jev del RAG (recomanat en un servidor sense GPU; sense ella el RAG carrega el reranker local, molt lent en CPU).
TYPESAFE_API_KEY=

# Correus de confirmació d'alta. true = sense correu (no cal SMTP).
ENABLE_EMAIL_AUTOCONFIRM=true
# SMTP_ADMIN_EMAIL=no-reply@parlaval.example.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SENDER_NAME=ParlaVal

# Secrets de Supabase: genera'ls (no els escrigues a mà) amb
#   node deploy/generate-secrets.mjs >> .env
# POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY i MCP_AUTH_TOKEN (token compartit entre l'API i
# el servidor MCP; si no el definixes, el servici MCP funciona sense token dins de la xarxa de compose).
